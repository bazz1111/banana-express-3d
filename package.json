{
  "name": "banana-express",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm check:compressed && tsc --noEmit && vite build && node scripts/precompress-dist.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "check:assets": "node scripts/check-assets.mjs",
    "smoke": "node scripts/smoke-shots.mjs",
    "perf": "node scripts/perf-check.mjs",
    "assets:compress": "node scripts/compress-assets.mjs",
    "check:compressed": "node scripts/check-compressed.mjs",
    "assets:fingerprint": "node scripts/asset-fingerprint.mjs check",
    "assets:fingerprint:update": "node scripts/asset-fingerprint.mjs write",
    "assets:precompress": "node scripts/precompress-dist.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "meshoptimizer": "1.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
